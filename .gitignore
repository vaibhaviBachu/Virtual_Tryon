# --- Secrets ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.pyc
.venv/
.venv-check/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Docker / infra local state ---
infrastructure/docker/volumes/

# --- AI models & large data (never committed — see ai/models/LICENSES.md) ---
ai/models/weights/
*.pt
*.onnx
*.safetensors

# --- Evaluation datasets / user photos (never committed) ---
# Documentation (SOURCES.md) is tracked; actual image bytes are generated locally by
# evaluation/scripts/generate_synthetic_dataset.py or fetched per SOURCES.md, never
# committed — see docs/milestone-3-verification.md §10.
!evaluation/data/
!evaluation/data/test_images/
evaluation/data/*/*
!evaluation/data/test_images/SOURCES.md
evaluation/users/*/*
!evaluation/users/*/.gitkeep
evaluation/jewellery/*/*
!evaluation/jewellery/*/.gitkeep
evaluation/expected/*
!evaluation/expected/.gitkeep

# --- OS / editor ---
.DS_Store
*.swp
.vscode/
.idea/

# --- Logs ---
*.log

# --- Local dev artifacts (native-process verification, see docs/development.md) ---
dump.rdb
.venv/
.venv-check/

# --- Ad-hoc calibration/debug output (real-camera captures, never committed) ---
debug_out/
debug_out2/
debug_out3/
debug_out4/
*.bundle
