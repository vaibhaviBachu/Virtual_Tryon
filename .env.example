# Copy this file to `.env` and adjust as needed. NEVER commit the real `.env`.
#
# All local ports intentionally start at 2001 (see docs/architecture.md §2) because the
# developer's machine already has common defaults (3000, 5432, 6379, 8000, 9000, ...)
# occupied by other projects.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Ports ---
WEB_PORT=2001
API_PORT=2002
POSTGRES_PORT=2003
REDIS_PORT=2004
MINIO_PORT=2005
MINIO_CONSOLE_PORT=2006
WORKER_PORT=2007
NGINX_PORT=2008
FLOWER_PORT=2009

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jewellery_tryon
# Host-side value the api/worker containers use (Docker service name + internal port,
# NOT the published host port above).
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/jewellery_tryon

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally; swap endpoint/keys for S3 or R2 in production) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jewellery-tryon
MINIO_SECURE=false

# --- JWT / auth (architecture ready; not enforced on any route yet in Milestone 1) ---
JWT_SECRET_KEY=change-me-in-every-non-local-environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:2001

# --- Frontend (inlined into the client bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:2002
