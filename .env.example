# Copy this file to `.env` and adjust as needed. NEVER commit the real `.env`.
#
# All local ports intentionally start at 2001 (see docs/architecture.md §2) because the
# developer's machine already has common defaults (3000, 5432, 6379, 8000, 9000, ...)
# occupied by other projects.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Ports ---
WEB_PORT=2001
API_PORT=2002
POSTGRES_PORT=2003
REDIS_PORT=2004
MINIO_PORT=2005
MINIO_CONSOLE_PORT=2006
WORKER_PORT=2007
NGINX_PORT=2008
FLOWER_PORT=2009

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jewellery_tryon
# Host-side value the api/worker containers use (Docker service name + internal port,
# NOT the published host port above).
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/jewellery_tryon

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally; swap endpoint/keys for S3 or R2 in production) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jewellery-tryon
MINIO_SECURE=false
# MINIO_ENDPOINT (minio:9000) is the Docker-internal hostname apps/api and workers use
# to reach MinIO — it is NOT reachable from your browser. MINIO_PUBLIC_ENDPOINT is used
# only when apps/api signs a URL to hand back to the browser (jewellery previews,
# try-on results); it must be the host-mapped address instead. If you change
# MINIO_PORT above from its default (2005), update this to match.
MINIO_PUBLIC_ENDPOINT=localhost:2005
MINIO_PUBLIC_SECURE=false

# --- JWT / auth (architecture ready; not enforced on any route yet in Milestone 1) ---
JWT_SECRET_KEY=change-me-in-every-non-local-environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:2001

# --- Frontend (inlined into the client bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:2002

# --- AI Jewellery Assistant (server-side only; never NEXT_PUBLIC_) ---
# Leave both API keys empty to run with the assistant fully present in the UI but
# reporting "AI service is not configured" wherever it would otherwise call out.
#
# Two provider options -- pick ONE pair and leave the other key empty:
#   "openai" (an OpenAI-compatible HTTP API) -> uses AI_API_KEY
#   "gemini" (Google's Gemini API, free tier available) -> uses GEMINI_API_KEY
AI_IMAGE_PROVIDER=gemini
AI_TEXT_PROVIDER=gemini
AI_IMAGE_MODEL=gemini-3.1-flash-image
AI_TEXT_MODEL=gemini-3.8-flash
AI_API_KEY=
GEMINI_API_KEY=
AI_MAX_GENERATIONS_PER_ITEM=3
AI_MAX_UPLOAD_MB=10
AI_RATE_LIMIT_PER_HOUR=20
